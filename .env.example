DATABASE_URL=postgresql://mydoglog:password@localhost:5433/mydoglog
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3847
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3847
CRON_SECRET=

# pollen-sparr (PawPollen) integration
# Local: point at the public API. VPS: container-to-container over the shared
# `web` Docker network (no Caddy, no TLS). Key lives only in this env file.
POLLEN_SPARR_BASE_URL=https://api.pawpollen.com
POLLEN_SPARR_API_KEY=

# Production overrides (set on VPS in /root/mydoglog/.env):
# POSTGRES_PASSWORD=<strong-password>
# BETTER_AUTH_SECRET=<openssl rand -base64 32>
# BETTER_AUTH_URL=https://mydoglog.ca
# NEXT_PUBLIC_BETTER_AUTH_URL=https://mydoglog.ca
# CRON_SECRET=<must match GitHub Actions secret>
# POLLEN_SPARR_BASE_URL=http://pollen-sparr:6500
# POLLEN_SPARR_API_KEY=<dedicated mydoglog key from pollen-sparr POLLEN_SPARR_API_KEYS>
